, "name": "Major OL Injury Fade", "win": "55.8%", "record": "32-16 (66.7%)", "rate": 0.6667, "stake": 0.5, "sample": "Small", "where": "NFL card, 0.5u", "why": "Team missing 3+ offensive-line starters (Out, Doubtful or on IR), opponent isn't: bet against them (small backtest of 48 bets: 0.5u until it has a live record)"}, {"stars": 3, "name": "Stacked Setups", "win": "56.7%", "record": "45-23 (66.2%)", "rate": 0.6618, "stake": 0.5, "sample": "Small", "where": "NFL card, 0.5u (new: first live season)", "why": "TWO OR MORE card setups are on the same side of the same game's spread: the bet takes the higher of the two ratings (small backtest of 68 bets: 0.5u until it has a live record) (new: 0.5u through its first live season)"}, {"stars": 4, "name": "Healthier Team + Model", "win": "57.6%", "record": "69-37 (65.1%)", "rate": 0.6509, "stake": 0.5, "sample": "Medium", "where": "NFL card, 0.5u", "why": "One team is missing 3+ more regular starters AND the model is also on the healthier team (small backtest of 106 bets: 0.5u until it has a live record)"}, {"stars": 5, "name": "Division Dog Teaser", "win": "58.6%", "record": "157-36 (81.3% per leg)", "rate": 0.6355, "stake": 1.5, "sample": "Medium", "where": "NFL card, 1.5u", "why": "Two DIVISION underdogs at +1.5 to +2.5 (totals under 49) teased 6 pts: division games stay close"}, {"stars": 2, "name": "International Favorite", "win": "55.3%", "record": "36-21 (63.2%)", "rate": 0.6316, "stake": 0.5, "sample": "Small", "where": "NFL card, 0.5u", "why": "Game played abroad (London, Germany, Mexico, Brazil...): the better team handles the trip (small backtest of 57 bets: 0.5u until it has a live record)"}, {"stars": 4, "name": "NFL Wind Under", "win": "57.9%", "record": "105-62 (62.9%)", "rate": 0.6287, "stake": 1.25, "sample": "Medium", "where": "NFL card, 1.25u", "why": "Outdoor game with 12+ mph wind forecast AND the model is under: bet it early in the week, the total drops ~1 pt by kickoff"}, {"stars": 1, "name": "Tired Defenses Over", "win": "54.9%", "record": "40-26 (60.6%)", "rate": 0.6061, "stake": 0.5, "sample": "Small", "where": "NFL card, 0.5u (new: first live season)", "why": "BOTH defenses were on the field for 73+ offensive plays last week: bet the over (new: 0.5u through its first live season)"}, {"stars": 4, "name": "Rush Yards Under", "win": "58.4%", "record": "269-176 (60.4%)", "rate": 0.6045, "stake": 0.5, "sample": "Big", "where": "NFL card, 0.5u", "why": "Our projection is 5+ yards (0.25 SD) under a running back's rushing-yards line and his team isn't a 3+ point favorite: bet the under. Books shade prop overs because the public bets them; teams that aren't comfortably ahead don't lean on the run late (bet ~2 hours before kickoff from the Sunday props run, 0.5u until 50 live bets at that timing)"}, {"stars": 4, "name": "Market Model Dog", "win": "57.5%", "record": "228-155 (59.5%)", "rate": 0.5953, "stake": 0.5, "sample": "Big", "where": "NFL card, 0.5u (new: first live season)", "why": "Our market model starts from Vegas's line and predicts only how far the result lands from it. When it says an UNDERDOG is 1.5+ pts underpriced, bet the underdog near kickoff (the Sunday run) (new: 0.5u through its first live season)"}, {"stars": 2, "name": "New Coach Bump", "win": "55.0%", "record": "54-37 (59.3%)", "rate": 0.5934, "stake": 0.5, "sample": "Small", "where": "NFL card, 0.5u", "why": "A team that changed head coaches mid-season, in the new coach's first 3 games: back it. The market still prices the fired coach's results; teams respond to the change (small backtest of 91 bets: 0.5u until it has a live record)"}, {"stars": 3, "name": "Follow the Money Total", "win": "56.4%", "record": "137-95 (59.1%)", "rate": 0.5905, "stake": 0.5, "sample": "Medium", "where": "NFL card, 0.5u (new: first live season)", "why": "On a game's total, the share of MONEY on one side is 15+ points higher than its share of TICKETS: fewer, bigger bets are there. Bet that side near kickoff (the Sunday run; needs that day's splits screenshot) (new: 0.5u through its first live season)"}, {"stars": 1, "name": "Kicking-Luck Fade", "win": "54.3%", "record": "37-26 (58.7%)", "rate": 0.5873, "stake": 0.5, "sample": "Small", "where": "NFL card, 0.5u", "why": "Team kicking 1.5+ pts/game above expected this season: field-goal luck fades"}, {"stars": 3, "name": "Dog Teaser (2-team)", "win": "56.7%", "record": "378-108 (77.8% per leg)", "rate": 0.5809, "stake": 1.0, "sample": "Big", "where": "NFL card, 1u", "why": "Underdog +1.5 to +2.5 in a game totaled under 49, teased 6 pts through 3 and 7; pair two legs"}, {"stars": 2, "name": "Q Full Practice", "win": "55.1%", "record": "102-76 (57.3%)", "rate": 0.573, "stake": 0.5, "sample": "Medium", "where": "NFL card, 0.5u (new: first live season)", "why": "2+ regular starters listed QUESTIONABLE but they practiced IN FULL on the final practice day, and the opponent has none: the market marks the team down for the tag, but these players almost always play. Back them (needs Friday's report, so the Saturday run) (new: 0.5u through its first live season)"}, {"stars": 2, "name": "Primetime Blowout Winner", "win": "55.0%", "record": "147-113 (56.5%)", "rate": 0.5654, "stake": 0.75, "sample": "Medium", "where": "NFL card, 0.75u", "why": "Won by 17+ in a primetime game last week (8pm ET+, Monday or Thursday), opponent didn't: back them. The market under-rates national-TV blowouts (daytime blowout winners do the opposite: 45%)"}, {"stars": 1, "name": "Revenge Over", "win": "54.7%", "record": "114-88 (56.4%)", "rate": 0.5644, "stake": 0.5, "sample": "Medium", "where": "NFL card, 0.5u (new: first live season)", "why": "A starting QB faces a team he started 8+ games for, or a head coach faces a team he coached 16+ games: bet the over (new: 0.5u through its first live season)"}, {"stars": 1, "name": "OL Injury Fade", "win": "54.3%", "record": "167-135 (55.3%)", "rate": 0.553, "stake": 0.5, "sample": "Big", "where": "NFL card, 0.5u", "why": "